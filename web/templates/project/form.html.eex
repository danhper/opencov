<%= form_for @changeset, @action, [class: "full-page"], fn f -> %>
  <%= if @changeset.action do %>
    <div class="alert alert-danger">
      <p>Could not create the project, please check the errors below:</p>
    </div>
  <% end %>

  <%= input(f, :name) %>
  <%= input(f, :base_url) %>
  <%= input(f, :commit_url_template, attrs: [placeholder: "https://git.example.com/project/repo/commits/{sha}"]) %>
  <p class="help-block">
    Optional. Only needed when commit links are wrong for your git host
    (GitHub, GitLab and bitbucket.org are detected automatically).
    <code>{sha}</code> is replaced with the commit hash.
  </p>

  <div class="form-group">
    <%= submit "Submit", class: "btn btn-primary" %>
  </div>
<% end %>
